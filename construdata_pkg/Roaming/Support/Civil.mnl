(defun c:za ( / tmp )
  (setq tmp (getvar "CMDECHO") )
  (setvar "CMDECHO" 0 )
  (command "._zoom" "_a")
  (setvar "CMDECHO" tmp )
  (princ)
)

(defun c:zc ( / tmp )
  (setq tmp (getvar "CMDECHO") )
  (setvar "CMDECHO" 0 )
  (command "._zoom" "_c")
  (setvar "CMDECHO" tmp )
  (princ)
)
