;;; The following checks to see if the Survey Link DC applicatoin is installed:
(defun IsSvLinkInstalled ( / sFileName IS_SV_DC_LINK_INSTALLED )
  (setq sFileName ".\\svlink\\Link32.exe")
  (setq IS_SV_DC_LINK_INSTALLED (findfile sFileName ))
  (if IS_SV_DC_LINK_INSTALLED 
    (menucmd "Gcivil.AECC_StartSurveyLink=")
    (menucmd "Gcivil.AECC_StartSurveyLink=~")
  )
  ;(princ IS_SV_DC_LINK_INSTALLED)
)
(IsSvLinkInstalled)
