(defun c:lll () 
(command "_tilemode" 1  "")
(command "_limits" "" "1000,1000")
(princ)
)

(defun c:xclipframetoggle ()
  (ai_sysvar '("cmdecho" . 0))
  (if (eq (getvar "xclipframe") 1)
    (setvar "xclipframe" 0)
    (setvar "xclipframe" 1)
  )
  (ai_sysvar NIL)
  (princ)
)

