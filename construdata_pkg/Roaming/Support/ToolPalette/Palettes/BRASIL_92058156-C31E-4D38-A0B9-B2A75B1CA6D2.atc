					<Params>
						<Side DataType="long" TypeInfo="16" DisplayName="Side" Description="Side">0<Enum><Left DisplayName="Left">1</Left><Right DisplayName="Right">0</Right></Enum></Side>
						<Insertion DataType="long" TypeInfo="16" DisplayName="Ponto de inserção" Description="Specifies insertion point of the lane either at the crown, or at the edge of travel way">301<Enum><Crown DisplayName="Crown">301</Crown><EdgeOfTravelWay DisplayName="EdgeOfTravelWay">302</EdgeOfTravelWay></Enum></Insertion>
						<CrownPointOnInside DataType="long" TypeInfo="16" DisplayName="Coroamento interno? (Y/N)" Description="Specifies that inside edge of travelway be coded as Crown">11<Enum><Yes DisplayName="Yes">10</Yes><No DisplayName="No">11</No></Enum></CrownPointOnInside>
						<Width DataType="double" TypeInfo="16" DisplayName="Largura" Description="Width of the lane from the offset of the inside edge to the offset of the outside edge">2.4</Width>
						<BaseDepth DataType="double" TypeInfo="16" DisplayName="Espessura da Base" Description="Depth of base course">0.1</BaseDepth>
						<DefaultSlope DataType="double" TypeInfo="9" DisplayName="Inclinação padrão" Description="Default slope of the lane to be used when the superelevation slope for the alignment is not defined">-0.02</DefaultSlope>
						<Pave1Depth DataType="double" TypeInfo="16" DisplayName="Espessura da Capa 1" Description="Thickness of the Pave1 layer (zero to omit)">0.025</Pave1Depth>
						<Pave2Depth DataType="double" TypeInfo="16" DisplayName="Espessura da Capa 2" Description="Thickness of the Pave2 layer (zero to omit).">0.025</Pave2Depth>
						<SubbaseDepth DataType="double" TypeInfo="16" DisplayName="Espessura da Subbase" Description="Thickness of the subbase layer (zero to omit)">0.3</SubbaseDepth>
						<Inclinação DataType="double" TypeInfo="9" DisplayName="Inclinação do acostamento" Description="Inclinação ">-0.05</Inclinação>
						<SubbaseExtension DataType="double" TypeInfo="16" DisplayName="Sobrelargura da Subbase" Description="SubbaseExtension">0.1</SubbaseExtension>
						<Pave2Extension DataType="double" TypeInfo="16" DisplayName="Sobrelargura da Capa 2" Description="Extension Beyond Pave1">0.1</Pave2Extension>
						<BaseExtensionSlope DataType="double" TypeInfo="9" DisplayName="Inclinação da Base escalonada" Description="% slope of the base extension">-0.02</BaseExtensionSlope>
						<BaseExtension DataType="double" TypeInfo="16" DisplayName="Sobrelargura da Base" Description="Extension Beyond Pave2">0.1</BaseExtension>
						<Pave2ExtensionSlope DataType="double" TypeInfo="9" DisplayName="Inclinação da Capa 2 escalonada" Description="% slope of the Pave2 extension">-0.02</Pave2ExtensionSlope>
						<Super DataType="long" TypeInfo="16" DisplayName="Aplicação de Superelevação" Description="Super">20<Enum><LeftInsideLane DisplayName="Left Inside Lane Slope">20</LeftInsideLane><LeftInsideShoulder DisplayName="Left Inside Shoulder Slope">21</LeftInsideShoulder><LeftOutsideLane DisplayName="Left Outside Lane Slope">22</LeftOutsideLane><LeftOutsideShoulder DisplayName="Left Outside Shoulder Slope">23</LeftOutsideShoulder><RightInsideLane DisplayName="Right Inside Lane Slope">24</RightInsideLane><RightInsideShoulder DisplayName="Right Inside Shoulder Slope">25</RightInsideShoulder><RightOutsideLane DisplayName="Right Outside Lane Slope">26</RightOutsideLane><RightOutsideShoulder DisplayName="Right Outside Shoulder Slope">27</RightOutsideShoulder><None DisplayName="None">-1</None></Enum></Super>
					</Params>
