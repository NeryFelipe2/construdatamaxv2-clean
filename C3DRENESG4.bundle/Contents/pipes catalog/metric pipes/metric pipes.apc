	<Desc>Metric Pipe Catalog</Desc>
	<DefaultLinearUnits>mm</DefaultLinearUnits>
	<Images>
		<Image>
			<URL xlink:title="Catalog Image" xlink:href="Autodesk Logo.jpg" xlink:show="embed" xlink:actuate="onLoad"/>
		</Image>
	</Images>
	<Supplier name="Generic">
		<Images>
			<Image>
				<URL xlink:title="Logo" xlink:href="Autodesk Logo.jpg" xlink:show="embed" xlink:actuate="onLoad"/>
			</Image>
		</Images>
		<Link>
			<URL xlink:title="Metric Pipe Catalog" xlink:href="http://www.autodesk.com" xml:lang="en"/>
		</Link>
	</Supplier>
	<Extrinsics>
		<Extrinsic>
			<AeccCIRules>
				<DomainHierarchy>
					<Domain>
						<DomainEnum>Pipe_Domain</DomainEnum>
						<Type>
							<TypeEnum>Pipe</TypeEnum>
						</Type>
					</Domain>
				</DomainHierarchy>
				<DomainSet>
					<DomainEnum>Pipe_Domain</DomainEnum>
				</DomainSet>
				<TypeSet>
					<TypeEnum>Pipe</TypeEnum>
					<TypeEnum>Elbow</TypeEnum>
					<TypeEnum>Tee</TypeEnum>
					<TypeEnum>Wye</TypeEnum>
					<TypeEnum>Cross</TypeEnum>
					<TypeEnum>Takeoff</TypeEnum>
					<TypeEnum>Transition</TypeEnum>
					<TypeEnum>Coupling</TypeEnum>
					<TypeEnum>Endcap</TypeEnum>
				</TypeSet>
				<SubTypeSet>
					<SubTypeString>Simples</SubTypeString>
					<SubTypeString>Duplo</SubTypeString>
					<SubTypeString>Triplo</SubTypeString>
				</SubTypeSet>
				<ShapeSet>
					<PartShapeEnum>Round</PartShapeEnum>
				</ShapeSet>
				<ConnectionTypeSet>
					<ConnectionTypeEnum>Undefined_Connection_Type</ConnectionTypeEnum>
				</ConnectionTypeSet>
				<MaterialSet></MaterialSet>
				<ParameterSet>
					<ParameterString>BTRowID</ParameterString>
					<ParameterString>PID</ParameterString>
					<ParameterString>WTh</ParameterString>
					<ParameterString>CTravBool</ParameterString>
					<ParameterString>PDom</ParameterString>
					<ParameterString>PTyp</ParameterString>
					<ParameterString>PSTyp</ParameterString>
					<ParameterString>PrtNm</ParameterString>
					<ParameterString>PrtD</ParameterString>
					<ParameterString>PrtID</ParameterString>
					<ParameterString>DVer</ParameterString>
					<ParameterString>CntTy</ParameterString>
					<ParameterString>HPrtF</ParameterString>
					<ParameterString>CSS</ParameterString>
					<ParameterString>CusSF</ParameterString>
					<ParameterString>Espacamento</ParameterString>
					<ParameterString>CatID</ParameterString>
					<ParameterString>PrtSN</ParameterString>
					<ParameterString>BdyD1</ParameterString>
					<ParameterString>LenA2</ParameterString>
					<ParameterString>LenA3</ParameterString>
					<ParameterString>LenA1</ParameterString>
					<ParameterString>PIW</ParameterString>
					<ParameterString>PIH</ParameterString>
					<ParameterString>Misula</ParameterString>
				</ParameterSet>
				<UnitsSet>
					<UnitsEnum/>
					<UnitsEnum>inch</UnitsEnum>
					<UnitsEnum>ft</UnitsEnum>
					<UnitsEnum>mm</UnitsEnum>
					<UnitsEnum>cm</UnitsEnum>
					<UnitsEnum>m</UnitsEnum>
					<UnitsEnum>deg</UnitsEnum>
				</UnitsSet>
				<RelativePathPreference>Table</RelativePathPreference>
			</AeccCIRules>
		</Extrinsic>
	</Extrinsics>
