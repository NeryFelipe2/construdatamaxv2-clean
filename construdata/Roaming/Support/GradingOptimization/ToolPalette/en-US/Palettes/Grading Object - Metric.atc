			</Data>
		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{EB054E30-F0A4-41D6-83BC-EE9AC8751BFB}"/><Properties><ItemName>Offset Points</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Elevation_offset.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Elevation_offset.png"/></Images><Description>Offset Points</Description><ToolTip>An offset points controls the elevation difference between each end of the line segment. A positive value for the offset points tries to keep the first point higher than the end of the segment. A negative value forces the start point to be lower.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_elevation_offset</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-09-04T11:56:38" modifiedUniversalDateTime="2020-09-04T11:56:38"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{C0530EE0-3BA9-4D02-8262-B60D02849401}"/><Data>
