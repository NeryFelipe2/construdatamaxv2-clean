		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{CF08A139-E797-4883-9B9C-163A1E09955F}"/><Properties><ItemName>Pond</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Pond.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Pond.png"/></Images><Description>Pond</Description><ToolTip>A pond is a closed geometric shape representing properties and constraints for a dry or wet pond.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_pond</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-07-31T07:19:48" modifiedUniversalDateTime="2020-07-31T07:19:48"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{85CD3CF4-7384-4840-B5BD-DAFAE966D813}"/><Data>
