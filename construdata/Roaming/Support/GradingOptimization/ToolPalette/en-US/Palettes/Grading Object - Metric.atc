			</Data>
		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{3A0F0A05-FBCF-4719-B2E6-D978F2EE1738}"/><Properties><ItemName>Pathway</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\pathway.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\pathway.png"/></Images><Description>Pathway</Description><ToolTip>A pathway allows to define cross slope and width contraints along a line.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_pathway</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2022-04-20T13:00:00" modifiedUniversalDateTime="2022-04-20T13:00:00"/></Properties><Source/><ToolType>1</ToolType><StockToolRef idValue="{F2B176C1-C159-49A5-A7D2-F9851D3D9E5A}"/><Data>
