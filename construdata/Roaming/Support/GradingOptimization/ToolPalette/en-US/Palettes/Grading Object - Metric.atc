			</Data>
		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{D76A791D-7B24-4178-A511-EF4A72DD90B2}"/><Properties><ItemName>Ridge Line</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Ridge_line.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Ridge_line.png"/></Images><Description>Ridge Line</Description><ToolTip>Ridge lines control the slope direction of surface triangles to allow drainage away from the line. The beginning of the line is the low point and the end of the line is the high point of the ridge.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_ridge_line</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2022-04-14T11:56:38" modifiedUniversalDateTime="2022-04-14T11:56:38"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{E0CA971C-E598-4816-A1A7-C84EFBBD6A16}"/><Data>
