			</Data>
		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{2F36D003-8EDE-48EA-8D08-1D3B7A9E7FD5}"/><Properties><ItemName>Drain Line</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Drain_line.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Drain_line.png"/></Images><Description>Drain Line</Description><ToolTip>Drain lines are drain elements that control the slope direction of the triangles. When assigning drain lines, the start of the line is the high point and the direction of the line is towards the low point.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_drain_line</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-09-04T11:56:38" modifiedUniversalDateTime="2020-09-04T11:56:38"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{FF3B308E-EC65-46C2-8099-F9FB801CEC04}"/><Data>
