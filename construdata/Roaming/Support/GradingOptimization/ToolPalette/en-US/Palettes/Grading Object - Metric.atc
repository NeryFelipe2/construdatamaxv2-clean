		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{C63323AA-7E15-4B6D-9C4F-152899C5587E}"/><Properties><ItemName>Aligned Edge</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Aligned_edge.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Aligned_edge.png"/></Images><Description>Aligned Edge</Description><ToolTip>An aligned edge attempts to create a well-defined surface geometry along a constant slope. Surface triangle edges that touch an aligned edge will attempt to align in the same direction and slope.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_aligned_edge</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-09-04T11:56:37" modifiedUniversalDateTime="2020-09-04T11:56:37"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{F16475A5-2C19-4B8C-BE7B-2230F91ED8D6}"/><Data>
