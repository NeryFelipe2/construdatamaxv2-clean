		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{9CD7DBE8-78B8-434D-9243-B5BAD72F548B}"/><Properties><ItemName>Exclusion Zone</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Avoidance_area.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Avoidance_area.png"/></Images><Description>Exclusion Zone</Description><ToolTip>In an exclusion zone, all the existing elevations are fixed so that no grading is allowed to happen.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_exclusion_zone</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-12-24T11:56:37" modifiedUniversalDateTime="2020-12-24T11:56:37"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{7953AEA9-1B3A-4941-BB42-4D545DEB583A}"/><Data>
