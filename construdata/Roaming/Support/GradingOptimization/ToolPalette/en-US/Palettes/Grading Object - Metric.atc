		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{7880C424-1501-4BA7-A5B7-9096F04BEF8C}"/><Properties><ItemName>Grading Limit</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Grading limit.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Grading limit.png"/></Images><Description>Grading limit</Description><ToolTip>A grading limit defines the boundary of grading.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_grading_limit</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-11-19T01:09:39" modifiedUniversalDateTime="2020-11-19T01:09:39"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{AFBDA9C2-4A01-44D3-8A35-E817C024B1FA}"/><Data>
