			</Data>
		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{66866D9B-6365-4E4E-A403-D85F1D3B9EF1}"/><Properties><ItemName>Retaining Wall</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Retaining_wall.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Retaining_wall.png"/></Images><Description>Retaining Wall</Description><ToolTip>A retaining wall breaks the terrain along the wall linework and steps the terrain within specified height constraints.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_retain_wall</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2021-07-30T11:06:39" modifiedUniversalDateTime="2021-07-30T11:06:39"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{A4EEDA88-EACE-4109-81F4-5FEB205BD0D9}"/><Data>
