		</Tool><Tool Revision="23.1.0" option="0"><ItemID idValue="{60EDD5EA-8B70-4379-8DB4-47DA6B763CC3}"/><Properties><ItemName>Low Point</ItemName><Images option="0"><Image cx="64" cy="64" IsDark="false" src="..\..\Images\light\Low_point.png"/><Image cx="64" cy="64" IsDark="true" src="..\..\Images\dark\Low_point.png"/></Images><Description>Low Point</Description><ToolTip>A low point is a reference point demarking a location as a low elevation point.</ToolTip><Help><HelpFile>https://help.autodesk.com/view/C3DGO/ENU/?contextId=id_dlg_tool_prop_low_point</HelpFile><HelpCommand>HELP_BROWSER_URL</HelpCommand></Help><Time createdUniversalDateTime="2020-09-04T11:56:36" modifiedUniversalDateTime="2020-09-04T11:56:36"/></Properties><ToolType>1</ToolType><StockToolRef idValue="{27583802-D603-42AE-8807-4DF963481700}"/><Data>
